{
  "name": "siteforge-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && vitest run --config vitest.server.config.ts",
    "test:ui": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "backend": "tsx server/start.ts",
    "backend:mock": "tsx scripts/mock-backend.ts",
    "backend:smoke": "node --import tsx server/smoke-start.ts",
    "test:smoke": "vitest run --config vitest.server.config.ts server/smoke-startup.test.ts",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.observability.config.ts",
    "test:observability": "npm run build && playwright test --config playwright.observability.config.ts",
    "verify:bundle": "node scripts/verify-build.mjs",
    "smoke:observe": "npm run build && node --import tsx scripts/run-smoke-observer.ts"
  },
  "dependencies": {
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "prettier": "^3.9.10",
    "resize-observer-polyfill": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "latest"
  }
}
